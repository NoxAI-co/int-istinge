# ============================================================================
#  Plantilla de entorno por CLIENTE (instancia privada de int-istinge).
#  Copia este archivo a `clientes/<cliente>/.env` y ajusta lo marcado con <-- .
#  Genera la APP_KEY una sola vez por cliente:
#     docker run --rm integra-int:latest php artisan key:generate --show
#  y pégala abajo.
# ============================================================================

APP_NAME="Integra"                          # <-- nombre visible del cliente (opcional)
APP_ENV=production
APP_KEY=                                    # <-- base64:... (ver comando arriba)
APP_DEBUG=false
APP_URL=https://clienteX.tudominio.com/software   # <-- dominio del cliente + /software

# Identificador corto del cliente. new-client.sh lo reemplaza por el <cliente>
# que se pasa por CLI. Lo usan distintos módulos para nombrar carpetas/recursos.
CLIENTE=clienteX
# Subcarpetas usadas por la app dentro del storage compartido del cliente.
ADJUNTOS_FOLDER=adjuntos
GENERAL_FOLDER=general
LOGOS_FOLDER=logos
# ASSET_URL: opcional. Si no lo definís, ./deploy.sh lo iguala a APP_URL.
# Solo declaralo si querés servir los assets desde otro host (CDN, p. ej.).
# ASSET_URL=https://clienteX.tudominio.com/software

LOG_CHANNEL=stack

# ── Base de datos (MySQL — la BD que trae el cliente, ya importada) ──────────
DB_CONNECTION=mysql
DB_HOST=mysql                               # <-- host del servidor MySQL (servicio compartido)
DB_PORT=3306
DB_DATABASE=integra_clienteX                # <-- base de datos de ESTE cliente
DB_USERNAME=integra_clienteX                # <-- usuario propio del cliente
DB_PASSWORD=                                # <-- password del cliente

# ── Sesión / Cache / Cola (cada cliente usa SU propia BD, así que quedan aislados)
# Variables de Laravel 7 (CACHE_DRIVER / QUEUE_CONNECTION / SESSION_DRIVER).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/software                      # cookies acotadas al sub-path
SESSION_DOMAIN=null

CACHE_DRIVER=database
QUEUE_CONNECTION=database
BROADCAST_DRIVER=log

# ── Correo (Laravel 7 usa MAIL_DRIVER) ──────────────────────────────────────
MAIL_DRIVER=log                             # <-- cambia a 'smtp' en producción real
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Redis (no usado por defecto, pero la config de Laravel 7 lo referencia) ─
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Pusher (lo referencia config/broadcasting.php; déjalo vacío si no aplica) ─
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Status / Company ───────────────────────────────────────────────────────
# Comillas simples a propósito: el valor empieza con '$' y debe quedar literal
# (phpdotenv solo expande ${VAR}, pero las simples también protegen contra un
# `source .env` o `set -a; . .env` accidental que sí expandiría $Int).
STATUS_COMPANY_PASS='$Int@r4a2026*%.'
