APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── WhatsApp / Meta Cloud API ─────────────────────────────────────────────────
#
# Las tres variables de abajo se dejan VACÍAS en producción. No es un olvido;
# es como funciona el sistema. Se documentan para que nadie las "arregle".
#
# El access token NO vive aquí: se guarda por instancia en la tabla `instances`
# y se administra desde Configuración -> Instancias WhatsApp. ChatController lo
# pasa al construir el servicio y el webhook usa setAccessToken(). Sólo puede
# haber una instancia habilitada por empresa.
#
# ACCESS_TOKEN_META es un fallback heredado para cuando no se pasa token al
# constructor. Está vacío en los 35 despliegues; el camino real es el de arriba.
ACCESS_TOKEN_META=""

# Las dos siguientes sólo harían falta si este despliegue recibiera webhooks de
# Meta directamente. Hoy no los recibe y no puede recibirlos:
#
#   Todas las WABAs de los clientes están suscritas a la app Ispintegra
#   (865904982715022), y una app de Meta tiene UN solo callback_url por tópico.
#   El de Ispintegra apunta al proyecto whatsapp-integra, no aquí. Verificado
#   contra Graph API en /{waba-id}/subscribed_apps.
#
# El camino entrante vivo es el polling de CronController::syncWhatsAppMetaLogs,
# que no depende de ninguna de estas dos.
#
# Con ellas vacías, /webhooks/whatsapp responde 403 a todo. Es lo correcto: la
# ruta existe pero nadie la llama, y antes aceptaba cualquier POST sin firma.
# Si algún día se le da su propia app de Meta a este proyecto, hay que llenarlas.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# App secret de la app de Meta (NO el access token: identifica la app, no el
# número). Sirve para validar la firma X-Hub-Signature-256 de los webhooks. No
# puede ser por instancia: la firma hay que validarla antes de leer el payload,
# y es el payload el que dice de qué instancia viene.
# Si varias apps entregaran a este servidor, van separadas por coma.
META_APP_SECRET=""
META_APP_SECRETS=""

# ── API saliente de whatsive / automatizadovip.com ────────────────────────────
# La usa CRMController@whatsappActions para enviar mensajes desde el CRM. Estaba
# hardcodeada en el código: si el servicio sigue en uso hay que rotarla en el
# panel del proveedor, porque la anterior quedó en el historial del repositorio.
WHATSIVE_API_KEY=""
