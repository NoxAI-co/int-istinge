APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── WhatsApp / Meta Cloud API ─────────────────────────────────────────────────
# Token de la Cloud API (se puede sobrescribir por instancia en la BD).
ACCESS_TOKEN_META=""

# Token que Meta envía en la verificación GET del webhook. OBLIGATORIO:
# sin él la ruta /webhooks/whatsapp responde 403 y no se puede dar de alta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# App secret de la app de Meta, usado para validar la firma X-Hub-Signature-256
# de cada webhook entrante. OBLIGATORIO: sin él el webhook rechaza TODO con 403.
# Si varias apps de Meta entregan a este servidor, van separadas por coma.
META_APP_SECRET=""
META_APP_SECRETS=""
